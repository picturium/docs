---
// A real request URL taken apart: each query parameter links to its entry
// below, and hovering or focusing one reads its note into the caption.
import { params } from '../data/reference';

const rows = Object.values(params).flat();
const example: [string, string][] = [['w', '600'], ['h', '400'], ['fit', 'cover'], ['g', 'attention'], ['f', 'auto'], ['q', 'high'], ['filter', 'sharpen:1.2']];
const hues = ['--px-red', '--px-orange', '--px-yellow', '--px-green', '--px-cyan', '--px-blue', '--px-magenta'];
const parts = example.map(([k, v], i) => {
  const row = rows.find((r) => r[0].split(' · ')[0] === k)!;
  return { k, v, label: row[0], note: row[3]!, href: row[4] ?? `#param-${k}`, c: `var(${hues[i % hues.length]})` };
});
const intro = 'Hover or focus a part of the URL to see what it does. Click a parameter to jump to it.';
---
<figure class="anatomy">
  <div class="anatomy-url">
    <span class="anatomy-method">GET</span>
    <span class="seg seg-path" tabindex="0" data-label="path" data-note="Selects the file, relative to data.dir. Everything picturium can read is already a URL.">/photos/cat.jpg</span><span class="anatomy-sep">?</span>{parts.map((p, i) => (
      <>{i > 0 && <span class="anatomy-sep">&amp;</span>}<a class="seg" href={p.href} style={`--c:${p.c}`} data-label={p.label} data-note={p.note}><b>{p.k}</b>=<i>{p.v}</i></a></>
    ))}
  </div>
  <figcaption class="anatomy-cap" aria-live="polite"><strong></strong><span>{intro}</span></figcaption>
</figure>

<script define:vars={{ intro }}>
  const fig = document.querySelector('.anatomy');
  const [label, note] = fig.querySelectorAll('.anatomy-cap > *');
  const show = (seg) => {
    label.textContent = seg ? seg.dataset.label : '';
    note.textContent = seg ? seg.dataset.note : intro;
  };
  fig.querySelectorAll('.seg').forEach((seg) => {
    seg.addEventListener('pointerenter', () => show(seg));
    seg.addEventListener('focus', () => show(seg));
  });
  fig.querySelector('.anatomy-url').addEventListener('pointerleave', () => fig.contains(document.activeElement) || show());
  fig.addEventListener('focusout', (e) => fig.contains(e.relatedTarget) || show());
</script>

<style>
  .anatomy { margin: 0 0 22px; }
  .anatomy-url {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 8px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    background: var(--bg-1);
    font: 13.5px/1.5 var(--f-mono);
    color: var(--ink-3);
  }
  .anatomy-method {
    margin-right: 12px;
    padding-right: 12px;
    border-right: 1px solid var(--line-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--px-green);
  }
  .seg {
    --c: var(--ink-3);
    padding: 1px 2px 2px;
    border-bottom: 2px solid color-mix(in srgb, var(--c) 55%, transparent);
    border-radius: 3px 3px 0 0;
    color: var(--ink-1);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .seg b { font-weight: 600; color: var(--c); }
  .seg i { font-style: normal; color: var(--ink-0); }
  .seg-path { color: var(--ink-0); }
  .seg:hover, .seg:focus-visible {
    outline: 0;
    background: color-mix(in srgb, var(--c) 16%, transparent);
    border-bottom-color: var(--c);
  }
  .anatomy-sep { padding: 0 2px; color: var(--ink-4); }
  .anatomy-cap {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    min-height: 3.6em;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    background: var(--bg-2);
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .anatomy-cap strong { font: 600 12.5px/1.65 var(--f-mono); color: var(--ink-0); }
  .anatomy-cap strong:empty { display: none; }
</style>

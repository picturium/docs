---
// Live filter over every ParamList marked `filterable`. Group headings (the h3
// right before each list) hide with their list when nothing in it matches.
---
<div class="param-filter">
  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5" />
    <path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
  <label class="sr" for="param-filter-input">Filter URL parameters</label>
  <input id="param-filter-input" type="search" placeholder="Filter parameters: fit, gravity, webp…" autocomplete="off" spellcheck="false" />
  <span class="param-filter-count" id="param-filter-count" aria-live="polite"></span>
</div>
<p class="param-filter-empty" id="param-filter-empty" hidden>No parameter matches that. The site search (<kbd>/</kbd>) covers every page.</p>

<script>
  const input = document.querySelector<HTMLInputElement>('#param-filter-input')!;
  const count = document.querySelector('#param-filter-count')!;
  const empty = document.querySelector<HTMLElement>('#param-filter-empty')!;
  const lists = [...document.querySelectorAll<HTMLElement>('.entries[data-filterable]')];
  const total = lists.reduce((n, l) => n + l.querySelectorAll('.entry').length, 0);

  const apply = () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const list of lists) {
      let any = false;
      list.querySelectorAll<HTMLElement>('.entry').forEach((p) => {
        // one or two letters only match names, or "w" would match every note
        const hit = !q || p.dataset.names!.includes(q) || (q.length > 2 && p.dataset.search!.includes(q));
        p.hidden = !hit;
        if (hit) { any = true; shown++; }
      });
      list.hidden = !any;
      const heading = list.previousElementSibling as HTMLElement | null;
      if (heading?.matches('h3')) heading.hidden = !any;
    }
    count.textContent = q ? `${shown} of ${total}` : `${total} parameters`;
    empty.hidden = shown > 0;
  };
  input.addEventListener('input', apply);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && input.value) { e.preventDefault(); input.value = ''; apply(); }
  });
  apply();
</script>

<style>
  .param-filter {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg-1);
    color: var(--ink-3);
    transition: border-color 0.15s, color 0.15s;
  }
  /* same treatment as the site search: the box carries focus, not a ring around the text */
  .param-filter:focus-within {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--accent);
  }
  .param-filter input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink-0);
    caret-color: var(--accent);
    font: 500 14px var(--f-mono);
  }
  .param-filter input:focus { outline: 0; }
  .param-filter input::placeholder { color: var(--ink-3); }
  .param-filter-count { flex: none; font: 11px var(--f-mono); color: var(--ink-3); }
  .param-filter-empty { margin: -8px 0 22px; font-size: 13.5px; color: var(--ink-3); }
  .param-filter-empty kbd {
    padding: 0 5px;
    border: 1px solid var(--line-2);
    border-radius: 4px;
    font: 11px var(--f-mono);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

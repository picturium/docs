---
// Interactive URL-param demo, wired to the real picturium instance. The query
// string is the instrument: the controls write it, and typing in it moves the
// controls. Every knob is an actual URL parameter; the preview is the response.
import { statSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { PICTURIUM } from '../consts';

const samples = [
  { id: 'skyscraper', label: 'skyscraper.jpg', by: 'Ü Lõ', href: 'https://unsplash.com/photos/skyscraper-with-illuminated-vertical-lines-C-672vHXRAg' },
  { id: 'palms', label: 'palms.jpg', by: 'Andrés Beltrán Espinosa', href: 'https://unsplash.com/photos/lush-tropical-trees-and-palm-fronds-against-a-blue-sky-RB5gUjPWmwA' },
  { id: 'highland-cow', label: 'highland-cow.jpg', by: 'Wilson', href: 'https://unsplash.com/photos/brown-shaggy-highland-cow-with-horns-in-a-green-pasture-q8TbJ0MKk4U' },
  { id: 'poolside', label: 'poolside.jpg', by: 'Maverick Frame', href: 'https://unsplash.com/photos/modern-outdoor-swimming-pool-with-lounge-chairs-and-city-views-NlFpj7dZlTI' },
  { id: 'coastal-town', label: 'coastal-town.jpg', by: 'Ahmet Yüksek', href: 'https://unsplash.com/photos/coastal-town-on-a-mountainside-overlooking-the-sea-6PJ9f66w2lw' },
].map((s) => ({
  ...s,
  // picturium serves public/ as its source dir, so the originals are right here
  bytes: statSync(fileURLToPath(new URL(`../../public/samples/${s.label}`, import.meta.url))).size,
}));

const tabs = [
  { id: 'size', label: 'Size', fields: [
    { key: 'w', label: 'Width', min: 120, max: 1600, step: 20, unit: 'px' },
    { key: 'h', label: 'Height', min: 120, max: 1200, step: 20, unit: 'px' },
    { seg: 'fit', label: 'Fit', options: ['cover', 'contain', 'force'] },
    { seg: 'rot', label: 'Rotate', options: ['no', '90', '180', '270'] },
    { pad: 'g', label: 'Gravity' },
  ] },
  { id: 'filters', label: 'Filters', fields: [
    { section: 'Tone' },
    { key: 'brightness', label: 'Brightness', min: 0.2, max: 2, step: 0.05, unit: '' },
    { key: 'contrast', label: 'Contrast', min: 0.2, max: 2, step: 0.05, unit: '' },
    { key: 'saturate', label: 'Saturation', min: 0, max: 2, step: 0.05, unit: '' },
    { key: 'hue', label: 'Hue', min: 0, max: 360, step: 5, unit: '°', spectrum: true },
    { section: 'Effects' },
    { key: 'blur', label: 'Blur', min: 0, max: 20, step: 1, unit: '' },
    { key: 'sharpen', label: 'Sharpen', min: 0, max: 10, step: 0.5, unit: '' },
    { key: 'grayscale', label: 'Grayscale', min: 0, max: 1, step: 0.05, unit: '' },
    { key: 'sepia', label: 'Sepia', min: 0, max: 1, step: 0.05, unit: '' },
    { key: 'invert', label: 'Invert', min: 0, max: 1, step: 0.05, unit: '' },
    { key: 'pixelate', label: 'Pixelate', min: 1, max: 40, step: 1, unit: '' },
  ] },
  { id: 'output', label: 'Output', fields: [
    { seg: 'f', label: 'Format', wide: true, options: ['auto', 'avif', 'webp', 'jpg', 'png'] },
    { key: 'q', label: 'Quality', wide: true, min: 1, max: 100, step: 1, unit: '' },
  ] },
];
const tabKeys = (t) => t.fields.map((f) => f.key ?? f.seg ?? f.pad).filter(Boolean).join(',');
const pad = ['top-left', 'top', 'top-right', 'left', 'center', 'right', 'bottom-left', 'bottom', 'bottom-right'];

const defaults = {
  src: 'coastal-town', w: 900, h: 600, fit: 'cover', rot: 'no', g: 'center',
  blur: 0, sharpen: 0, brightness: 1, contrast: 1, saturate: 1, hue: 0,
  grayscale: 0, sepia: 0, invert: 0, pixelate: 1,
  f: 'auto', q: 82, qauto: true,
  watermark: 'image:picturium.png|opacity:70|anchor:top-right|scale:0.08',
  // params and filters the controls don't cover; passed through untouched
  extra: [], extraFilter: [],
};

// One click from defaults to a finished look. Each chip's thumbnail is rendered
// by picturium itself from the same parameters.
const recipes = [
  { name: 'Avatar', set: { w: 400, h: 400, g: 'attention' } },
  { name: 'Banner', set: { w: 1600, h: 500, g: 'entropy' } },
  { name: 'Noir', set: { grayscale: 1, contrast: 1.35, brightness: 0.95 } },
  { name: 'Duotone', set: { extraFilter: ['palette:ffd633,16181f'] } },
  { name: '8-bit', set: { pixelate: 12, saturate: 1.5, contrast: 1.15 } },
  { name: 'Faded film', set: { sepia: 0.35, contrast: 0.85, brightness: 1.08, saturate: 0.8 } },
  { name: 'Featherweight', set: { w: 480, h: 320, f: 'avif', q: 35, qauto: false } },
];
---
<div class="pg-wrap" id="pg" data-base={PICTURIUM} data-samples={JSON.stringify(samples)}
     data-defaults={JSON.stringify(defaults)} data-recipes={JSON.stringify(recipes)}>
  <div class="pg-url" id="pg-url">
    <div class="pg-url-head">
      <span class="pg-method">GET</span>
      <span class="pg-origin"><span class="h" id="pg-host"></span><span class="p" id="pg-path"></span></span>
      <span class="pg-url-hint" aria-hidden="true">editable</span>
      <button type="button" class="copy" id="pg-copy">copy</button>
    </div>
    <div class="pg-query">
      <span class="pg-qm" aria-hidden="true">?</span>
      <div class="pg-q-field">
        <div class="pg-q-view" id="pg-q-view" aria-hidden="true"></div>
        <textarea class="pg-q-edit" id="pg-q-edit" rows="1" spellcheck="false" autocomplete="off"
                  autocapitalize="off" aria-label="Query string. Edit it directly; the controls follow."></textarea>
      </div>
    </div>
    <div class="pg-url-load" aria-hidden="true"></div>
  </div>

  <div class="pg-recipes" role="group" aria-labelledby="pg-recipes-label">
    <span class="pg-recipes-label" id="pg-recipes-label">Recipes</span>
    <div class="pg-recipes-row">
      {recipes.map((r, i) => (
        <button type="button" class="pg-recipe" data-recipe={i} aria-pressed="false">
          <img alt="" width="28" height="28" loading="lazy" />
          <span>{r.name}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="pg-left">
    <div class="pg-stage">
      <div class="pg-frame" id="pg-frame">
        <img id="pg-img" alt="" />
        <img id="pg-before" class="pg-before" alt="" aria-hidden="true" />
        <span class="pg-tag pg-tag-l" aria-hidden="true">no filter</span>
        <span class="pg-tag pg-tag-r" aria-hidden="true">filtered</span>
        <div class="pg-handle" aria-hidden="true"><i></i></div>
        <input class="pg-split" id="pg-split" type="range" min="0" max="100" value="50"
               aria-label="Compare the filtered image with the unfiltered one" />
        <div class="pg-error" id="pg-error" role="alert" hidden>
          <strong id="pg-error-code"></strong>
          <span id="pg-error-msg"></span>
        </div>
        <div class="pg-chips" aria-live="polite">
          <span class="pg-chip"><svg class="chip-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg><span id="pg-chip-out"></span></span>
          <span class="pg-chip" id="pg-chip-ms"></span>
        </div>
      </div>
    </div>

    <dl class="pg-weight" aria-label="File size">
      <div class="pg-w-row">
        <dt>Original</dt>
        <dd class="pg-w-track"><i style="width:100%"></i></dd>
        <dd class="pg-w-val" id="pg-orig"></dd>
      </div>
      <div class="pg-w-row out">
        <dt>picturium</dt>
        <dd class="pg-w-track"><i id="pg-bar"></i></dd>
        <dd class="pg-w-val"><span id="pg-out"></span> <span class="pg-w-pct" id="pg-pct"></span></dd>
      </div>
    </dl>
    <p class="pg-credit">Photo by <a id="pg-credit" href="#" target="_blank" rel="noopener noreferrer"></a> on <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer">Unsplash</a></p>
  </div>

  <div class="pg-right">
    <div class="pg-field span2">
      <select class="pg-select" data-key="src" aria-label="Sample image">
        {samples.map((s) => <option value={s.id}>{s.label}</option>)}
      </select>
    </div>

    <div class="pg-tabs span2" role="tablist" aria-label="Adjustments">
      {tabs.map((t, i) => (
        <button type="button" class="pg-tab" role="tab" id={`pg-tab-${t.id}`} aria-controls={`pg-panel-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-keys={tabKeys(t)} data-tab={t.id}>
          {t.label}<span class="n" aria-label="changed"></span>
        </button>
      ))}
    </div>

    <div class="pg-panels span2">
      {tabs.map((t, i) => (
        <div class:list={['pg-panel', i > 0 && 'off']} role="tabpanel" id={`pg-panel-${t.id}`}
             aria-labelledby={`pg-tab-${t.id}`} inert={i > 0}>
          {t.fields.map((f) => f.section ? (
            <div class="pg-section span2">{f.section}</div>
          ) : f.pad ? (
            <div class="pg-field span2" data-field="g">
              <div class="pg-label"><span id="pg-g-label">{f.label}</span><span class="v" id="pg-g-val">{defaults.g}</span></div>
              <div class="pg-grav">
                <div class="pg-seg pg-pad" data-key="g" role="group" aria-labelledby="pg-g-label">
                  {pad.map((o) => <button type="button" value={o} aria-pressed={defaults.g === o} aria-label={o} title={o}><i></i></button>)}
                </div>
                <div class="pg-seg pg-smart" data-key="g" role="group" aria-label="Smart gravity">
                  <button type="button" value="attention" aria-pressed="false">attention<small>finds the subject</small></button>
                  <button type="button" value="entropy" aria-pressed="false">entropy<small>keeps the busiest detail</small></button>
                </div>
              </div>
            </div>
          ) : f.seg ? (
            <div class:list={['pg-field', f.wide && 'span2']} data-field={f.seg}>
              <div class="pg-label"><span id={`pg-${f.seg}-label`}>{f.label}</span></div>
              <div class="pg-seg" data-key={f.seg} role="group" aria-labelledby={`pg-${f.seg}-label`}>
                {f.options.map((o) => <button type="button" value={o} aria-pressed={defaults[f.seg] === o}>{o}</button>)}
              </div>
            </div>
          ) : (
            <div class:list={['pg-field', f.wide && 'span2']} data-field={f.key}>
              <label class="pg-label" for={`pg-${f.key}`}>
                <span>{f.label}</span>
                {f.key === 'q' && (
                  <label class="pg-auto"><input type="checkbox" id="pg-qauto" checked={defaults.qauto} /> auto</label>
                )}
                <span class="v" data-value-for={f.key}>{defaults[f.key]}{f.unit}</span>
              </label>
              <input class:list={['pg-slider', f.spectrum && 'hue']} id={`pg-${f.key}`} type="range" data-key={f.key} data-unit={f.unit}
                     min={f.min} max={f.max} step={f.step} value={defaults[f.key]} title="Double-click to reset" />
            </div>
          ))}
        </div>
      ))}
    </div>

    <button class="pg-reset" id="pg-reset">Reset</button>
  </div>
</div>

<script>
  const root = document.getElementById('pg');
  const base = root.dataset.base;
  const samples = JSON.parse(root.dataset.samples);
  const defaults = JSON.parse(root.dataset.defaults);
  const recipes = JSON.parse(root.dataset.recipes);
  const fresh = () => structuredClone(defaults);
  let state = fresh();

  const el = (id) => document.getElementById(id);
  const img = el('pg-img');
  const before = el('pg-before');
  const frame = el('pg-frame');
  const view = el('pg-q-view');
  const edit = el('pg-q-edit');

  const FILTERS = ['blur', 'sharpen', 'brightness', 'contrast', 'saturate', 'hue', 'grayscale', 'sepia', 'invert', 'pixelate'];
  const NEUTRAL = Object.fromEntries(FILTERS.map((k) => [k, defaults[k]]));
  const ALIAS = { width: 'w', height: 'h', gravity: 'g', rotate: 'rot', format: 'f', quality: 'q' };

  const fmtBytes = (b) =>
    b < 1024 ? b + ' B'
    : b < 1024 * 1024 ? (b / 1024).toFixed(b < 10240 ? 1 : 0) + ' KB'
    : (b / (1024 * 1024)).toFixed(2) + ' MB';

  const sample = () => samples.find((x) => x.id === state.src) ?? samples[0];
  const path = () => `/samples/${sample().label}`;

  const filterOf = (s) => [
    ...FILTERS.filter((k) => s[k] !== NEUTRAL[k]).map((k) => `${k}:${s[k]}`),
    ...s.extraFilter,
  ].join('|');

  function query(s = state, { filters = true } = {}) {
    const p = [];
    if (s.w != null) p.push(['w', s.w]);
    if (s.h != null) p.push(['h', s.h]);
    if (s.fit !== 'cover') p.push(['fit', s.fit]);
    if (s.rot !== 'no') p.push(['rot', s.rot]);
    if (s.g !== 'center') p.push(['g', s.g]);
    const filter = filters && filterOf(s);
    if (filter) p.push(['filter', filter]);
    if (s.watermark != null) p.push(['watermark', s.watermark]);
    if (s.f !== 'auto') p.push(['f', s.f]);
    // picturium's own default is q=medium; sending nothing leaves quality automatic
    if (!s.qauto) p.push(['q', s.q]);
    p.push(...s.extra);
    return p.map(([k, v]) => `${k}=${v}`).join('&');
  }

  // The reverse of query(): typed text back into state, so the controls follow.
  // Anything the controls can't show is kept verbatim in extra / extraFilter.
  function parse(text) {
    const s = { ...fresh(), src: state.src, w: null, h: null, watermark: null };
    for (const part of text.split('&')) {
      if (!part) continue;
      const i = part.indexOf('=');
      const raw = i < 0 ? part : part.slice(0, i);
      const v = i < 0 ? '' : part.slice(i + 1);
      const k = ALIAS[raw] ?? raw;
      const n = Number(v);
      if ((k === 'w' || k === 'h') && v !== '' && Number.isFinite(n)) s[k] = n;
      else if (['fit', 'rot', 'g', 'f'].includes(k)) s[k] = v;
      else if (k === 'q' && v !== '' && Number.isFinite(n)) { s.q = n; s.qauto = false; }
      else if (k === 'watermark') s.watermark = v;
      else if (k === 'filter') {
        for (const f of v.split('|')) {
          const [fk, fv] = [f.slice(0, f.indexOf(':')), f.slice(f.indexOf(':') + 1)];
          if (FILTERS.includes(fk) && fv !== '' && Number.isFinite(Number(fv))) s[fk] = Number(fv);
          else if (f) s.extraFilter.push(f);
        }
      } else s.extra.push([raw, v]);
    }
    return s;
  }

  // ── query highlighting ─────────────────────────────────────────────
  const GROUP = {
    w: 'size', h: 'size', fit: 'size', g: 'size', rot: 'size', ar: 'size', dpr: 'size', crop: 'size',
    pad: 'size', scale: 'size', filter: 'filter', f: 'out', q: 'out', watermark: 'mark',
  };
  const esc = (t) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  let shown = new Set();
  function paint(text, flash) {
    const tokens = text.split('&');
    view.innerHTML = tokens.map((t) => {
      const i = t.indexOf('=');
      const k = i < 0 ? t : t.slice(0, i);
      const group = GROUP[ALIAS[k] ?? k] ?? 'other';
      const hot = flash && t && !shown.has(t) ? ' hot' : '';
      const v = i < 0 ? '' : esc(t.slice(i + 1)).replace(/[|:,]/g, '<span class="sep">$&</span>');
      return `<span class="tok t-${group}${hot}"><span class="k">${esc(k)}</span>${i < 0 ? '' : '<span class="sep">=</span>'}<span class="v">${v}</span></span>`;
    }).join('<span class="amp">&amp;</span>') + '​';
    shown = new Set(tokens);
  }

  // ── loading ────────────────────────────────────────────────────────
  // Fetched rather than set straight on the img: Resource Timing zeroes
  // encodedBodySize cross-origin without Timing-Allow-Origin, and the blob
  // gives the exact byte count and the format picturium actually chose.
  let nonce = 0;
  async function load(q, id) {
    const t0 = performance.now();
    el('pg-url').classList.add('busy');
    let res;
    try {
      // cache= busts the browser cache only (picturium ignores it for its own
      // key), so the timing chip shows a real fetch instead of a memory hit.
      // Kept out of the displayed URL and the copy button on purpose.
      res = await fetch(`${base}${path()}?${[q, `cache=${id}`].filter(Boolean).join('&')}`);
    } catch {
      if (id === nonce) fail('offline', 'The demo server did not answer. Check your connection and try again.');
      return;
    }
    const ms = Math.round(performance.now() - t0);
    if (id !== nonce) return; // a newer request already went out
    if (!res.ok) {
      fail(`HTTP ${res.status}`, (await res.text().catch(() => '')) || res.statusText);
      return;
    }
    const blob = await res.blob();
    if (id !== nonce) return;
    const old = img.src;
    img.onload = () => {
      el('pg-chip-out').textContent =
        `${img.naturalWidth} × ${img.naturalHeight} · ${blob.type.replace('image/', '')}`;
      if (old.startsWith('blob:')) URL.revokeObjectURL(old);
      el('pg-url').classList.remove('busy');
    };
    img.src = URL.createObjectURL(blob);
    el('pg-error').hidden = true;
    frame.classList.remove('failed');
    el('pg-chip-ms').textContent = `↻ ${ms} ms`;
    weigh(blob.size);
    compare(q);
  }

  function fail(code, msg) {
    el('pg-url').classList.remove('busy');
    el('pg-error-code').textContent = code;
    el('pg-error-msg').textContent = msg;
    el('pg-error').hidden = false;
    frame.classList.add('failed');
    el('pg-out').textContent = '—';
    el('pg-pct').textContent = '';
    el('pg-bar').style.transform = 'scaleX(0)';
  }

  function weigh(out) {
    const orig = sample().bytes;
    const ratio = out / orig;
    el('pg-orig').textContent = fmtBytes(orig);
    el('pg-out').textContent = fmtBytes(out);
    el('pg-bar').style.transform = `scaleX(${Math.max(0.006, Math.min(1, ratio))})`;
    const pct = el('pg-pct');
    const d = Math.round((1 - ratio) * 100);
    pct.textContent = d >= 0 ? `−${d}%` : `+${-d}%`;
    pct.classList.toggle('worse', d < 0);
  }

  // Before/after only means something once a filter is on; the "before" is the
  // same geometry without the filter, so both images line up pixel for pixel.
  function compare(q) {
    const on = !!filterOf(state) && q === query();
    frame.classList.toggle('compare', on);
    if (on) before.src = `${base}${path()}?${query(state, { filters: false })}`;
  }

  // ── render ─────────────────────────────────────────────────────────
  let timer;
  function render({ typed = false } = {}) {
    const q = typed ? edit.value : query();
    if (!typed) edit.value = q;
    paint(q, !typed);
    el('pg-host').textContent = new URL(base).host;
    el('pg-path').textContent = path();
    img.alt = `Preview of ${sample().label} with the parameters above applied`;
    const credit = el('pg-credit');
    credit.textContent = sample().by;
    credit.href = sample().href;
    root.querySelectorAll('.pg-recipe').forEach((b) =>
      b.setAttribute('aria-pressed', String(query(cook(b.dataset.recipe)) === q)));
    marks();

    // debounced: a slider drag would otherwise fire a request per pixel
    clearTimeout(timer);
    timer = setTimeout(() => load(q, ++nonce), 250);
  }

  // Changed values light up, and each tab counts what changed inside it, so
  // nothing hides behind a tab you're not looking at.
  const changed = (k) => (k === 'q' ? !state.qauto : state[k] !== defaults[k]);
  function marks() {
    root.querySelectorAll('[data-field]').forEach((f) => f.classList.toggle('changed', changed(f.dataset.field)));
    root.querySelectorAll('.pg-tab').forEach((t) => {
      const n = t.dataset.keys.split(',').filter(changed).length
        + (t.dataset.tab === 'filters' ? state.extraFilter.length : 0);
      t.querySelector('.n').textContent = n || '';
    });
    el('pg-g-val').textContent = state.g;
  }

  // Push state into every control; used after typing, recipes and reset.
  function sync() {
    root.querySelectorAll('input[data-key]').forEach((input) => {
      const v = state[input.dataset.key];
      if (v != null) input.value = v;
      root.querySelector(`[data-value-for="${input.dataset.key}"]`).textContent =
        v == null ? 'auto' : v + input.dataset.unit;
    });
    root.querySelector('select[data-key]').value = state.src;
    el('pg-qauto').checked = state.qauto;
    applyQauto();
    root.querySelectorAll('.pg-seg').forEach((seg) => {
      seg.querySelectorAll('button').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.value === state[seg.dataset.key])));
    });
  }

  function set(key, value) {
    state[key] = value;
    const label = root.querySelector(`[data-value-for="${key}"]`);
    const input = root.querySelector(`input[data-key="${key}"]`);
    if (label && input) label.textContent = value + input.dataset.unit;
    render();
  }

  root.querySelectorAll('input[data-key]').forEach((input) => {
    input.addEventListener('input', () => set(input.dataset.key, Number(input.value)));
    input.addEventListener('dblclick', () => {
      input.value = defaults[input.dataset.key];
      set(input.dataset.key, defaults[input.dataset.key]);
    });
  });
  root.querySelector('select[data-key]').addEventListener('change', (e) => {
    set('src', e.target.value);
    thumbs();
  });

  const qslider = el('pg-q');
  const qval = root.querySelector('[data-value-for="q"]');
  function applyQauto() {
    state.qauto = el('pg-qauto').checked;
    qslider.disabled = state.qauto;
    qval.style.opacity = state.qauto ? '.35' : '';
  }
  el('pg-qauto').addEventListener('change', () => { applyQauto(); render(); });
  root.querySelectorAll('.pg-seg').forEach((seg) => {
    seg.addEventListener('click', (e) => {
      const btn = e.target.closest('button');
      if (!btn) return;
      // gravity has two groups (pad + smart) writing the same key
      root.querySelectorAll(`.pg-seg[data-key="${seg.dataset.key}"] button`)
        .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      set(seg.dataset.key, btn.value);
    });
  });

  // ── tabs ───────────────────────────────────────────────────────────
  const tabBtns = [...root.querySelectorAll('.pg-tab')];
  function pick(tab) {
    tabBtns.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = el(t.getAttribute('aria-controls'));
      panel.classList.toggle('off', !on);
      panel.inert = !on;
    });
  }
  tabBtns.forEach((t, i) => {
    t.addEventListener('click', () => pick(t));
    t.addEventListener('keydown', (e) => {
      const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
      if (!d) return;
      const next = tabBtns[(i + d + tabBtns.length) % tabBtns.length];
      pick(next);
      next.focus();
    });
  });

  // ── typing in the URL ──────────────────────────────────────────────
  edit.addEventListener('input', () => {
    // a pasted full URL keeps only its query; newlines can't be part of one
    let v = edit.value.replace(/[\r\n]+/g, '');
    if (v.includes('?')) v = v.slice(v.indexOf('?') + 1);
    if (v !== edit.value) edit.value = v;
    state = parse(v);
    sync();
    render({ typed: true });
  });
  edit.addEventListener('keydown', (e) => { if (e.key === 'Enter') e.preventDefault(); });
  // tidy the text back to the canonical form once you leave the field
  edit.addEventListener('blur', () => { if (edit.value !== query()) render(); });

  // ── recipes ────────────────────────────────────────────────────────
  const cook = (i) => ({ ...fresh(), src: state.src, ...recipes[i].set });
  root.querySelectorAll('.pg-recipe').forEach((b) => {
    b.addEventListener('click', () => {
      state = cook(b.dataset.recipe);
      sync();
      render();
    });
  });
  function thumbs() {
    root.querySelectorAll('.pg-recipe img').forEach((t) => {
      const filter = filterOf(cook(t.parentElement.dataset.recipe));
      t.src = `${base}${path()}?w=56&h=56&g=attention&watermark=false${filter ? '&filter=' + filter : ''}`;
    });
  }

  // ── compare handle ─────────────────────────────────────────────────
  const split = el('pg-split');
  split.addEventListener('input', () => frame.style.setProperty('--split', `${split.value}%`));

  el('pg-reset').addEventListener('click', () => {
    state = { ...fresh(), src: state.src };
    sync();
    render();
  });

  const copy = el('pg-copy');
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(new URL(`${base}${path()}?${edit.value}`, location.href).href);
    } catch {}
    copy.textContent = 'copied';
    copy.classList.add('ok');
    setTimeout(() => { copy.textContent = 'copy'; copy.classList.remove('ok'); }, 1100);
  });

  // Browsers restore the last-picked <select> option on reload, but state
  // starts from defaults — force the controls back in sync with what we render.
  sync();
  thumbs();
  render();
</script>


<script>
  // pixel burst on copy — squares match the hero background field
  const pxColors = ['--px-red', '--px-orange', '--px-yellow', '--px-green', '--px-cyan', '--px-blue', '--px-magenta']
    .map((v) => getComputedStyle(document.documentElement).getPropertyValue(v));
  const burst = (from) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const r = from.getBoundingClientRect();
    for (let i = 0; i < 24; i++) {
      const p = document.createElement('i');
      const size = 4 + Math.random() * 5;
      p.style.cssText = `position:fixed;left:${r.left + r.width / 2}px;top:${r.top + r.height / 2}px;width:${size}px;height:${size}px;background:${pxColors[i % pxColors.length]};pointer-events:none;z-index:99`;
      document.body.append(p);
      const a = (Math.random() * 2 - 1) * Math.PI * 0.9 - Math.PI / 2;
      const d = 60 + Math.random() * 110;
      p.animate(
        [
          { transform: 'translate(-50%,-50%) rotate(0deg)', opacity: 1 },
          {
            transform: `translate(${Math.cos(a) * d}px, ${Math.sin(a) * d + 90}px) rotate(${Math.random() * 540 - 270}deg)`,
            opacity: 0,
          },
        ],
        { duration: 1400 + Math.random() * 900, easing: 'cubic-bezier(.15,.6,.25,1)' },
      ).finished.finally(() => p.remove());
    }
  };

  // one copy button, wired by data-copy selector
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = document.querySelector(btn.dataset.copy);
      try {
        await navigator.clipboard.writeText(el.textContent.trim());
        btn.textContent = 'copied';
      } catch {
        // no clipboard permission (insecure origin, denied) — select it instead
        getSelection().selectAllChildren(el);
        btn.textContent = 'press ctrl+c';
      }
      burst(btn);
      setTimeout(() => (btn.textContent = 'copy'), 1500);
    });
  });

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // .armed hides the end state, .is-in plays it once the element scrolls into
  // view. Only for things below the fold, so nothing on screen blinks out.
  const reveal = (el, threshold, onIn) => {
    if (!el || reduced || !('IntersectionObserver' in window) || el.getBoundingClientRect().top <= innerHeight) return;
    el.classList.add('armed');
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      el.classList.add('is-in');
      onIn?.(el);
      io.disconnect();
    }, { threshold });
    io.observe(el);
  };

  // count numbers up from zero, in step with their bar (see .bench-row --r)
  const countUp = (root) => {
    root.querySelectorAll('[data-count]').forEach((el) => {
      const to = Number(el.dataset.count);
      const dp = (el.dataset.count.split('.')[1] ?? '').length;
      const delay = Number(el.closest('.bench-row')?.style.getPropertyValue('--r') || 0) * 90;
      const start = performance.now() + delay;
      el.textContent = (0).toFixed(dp);
      const tick = (now) => {
        const t = Math.min(1, Math.max(0, (now - start) / 900));
        el.textContent = (to * (1 - (1 - t) ** 3)).toFixed(dp);
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  };

  if ('IntersectionObserver' in window) {
    const sleeper = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('idle', !e.isIntersecting)));
    document.querySelectorAll('.hero, .ribbon, .how-flow').forEach((el) => sleeper.observe(el));
  }

  reveal(document.querySelector('.how-flow'), 0.3);
  reveal(document.querySelector('.bench'), 0.35, countUp);
  // closing section: strike out the pre-generated variants once it scrolls into view
  reveal(document.querySelector('.cta'), 0.35);

  const tabs = [...document.querySelectorAll('.term-tab')];
  const selectTab = (t) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      // roving tabindex: Tab reaches the tablist once, arrows move within it
      x.tabIndex = on ? 0 : -1;
      document.getElementById('tab-' + x.dataset.tab).hidden = !on;
    });
  };
  tabs.forEach((t) => t.addEventListener('click', () => selectTab(t)));
  document.querySelector('.term-tabs').addEventListener('keydown', (e) => {
    const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
    if (!step) return;
    e.preventDefault();
    const next = tabs[(tabs.indexOf(document.activeElement) + step + tabs.length) % tabs.length];
    next.focus();
    selectTab(next);
  });

  // hero chips: whatever picturium actually returned
  const hero = document.getElementById('hero-img');
  const fmtBytes = (b) => (b >= 1024 * 1000 ? (b / 1048576).toFixed(1) + ' MB' : Math.round(b / 1024) + ' KB');
  const heroChips = async () => {
    const src = hero.currentSrc || hero.src;
    const type = src.match(/f=(\w+)/)?.[1] ?? 'auto';
    const sizeChip = document.getElementById('hero-size');
    // naturalWidth is divided by the density srcset derived from sizes=, so it
    // reports CSS pixels, not what picturium rendered. Show it only until the
    // decoded bitmap below gives the real thing.
    sizeChip.textContent = `${hero.naturalWidth} × ${hero.naturalHeight} · ${type}`;
    // srcset means the browser picks the candidate; show the one it actually got.
    const url = new URL(src);
    url.searchParams.delete('cache');
    document.getElementById('hero-url-params').textContent = decodeURIComponent(`?${url.searchParams}`);
    const e = performance.getEntriesByName(src).pop();
    if (e) document.getElementById('hero-ms').textContent = `↻ ${Math.round(e.duration)} ms`;
    // Resource timing zeroes body sizes cross-origin unless the server sends
    // Timing-Allow-Origin, so measure the already-cached response instead. The
    // same blob decodes to the true pixel dimensions.
    const blob = await fetch(src, { cache: 'force-cache' })
      .then((r) => r.blob())
      .catch(() => null);
    if (!blob) return;
    const bitmap = await createImageBitmap(blob).catch(() => null);
    if (bitmap) {
      sizeChip.textContent = `${bitmap.width} × ${bitmap.height} · ${type}`;
      bitmap.close();
    }
    const before = Number(hero.dataset.original);
    if (before && blob.size) {
      document.getElementById('hero-delta').innerHTML =
        `${fmtBytes(before)}<span class="delta-arrow">→</span>${fmtBytes(blob.size)}` +
        `<span class="delta-pct">−${Math.round((1 - blob.size / before) * 100)}%</span>`;
    }
  };
  hero.complete ? heroChips() : hero.addEventListener('load', heroChips);

</script>


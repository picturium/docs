---
import { statSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../layouts/Base.astro';
import Playground from '../components/Playground.astro';
import { VERSION, REPO, PICTURIUM, px } from '../consts';

// Hero is a real picturium response; the chips below it are filled in from the
// resource timing entry rather than hard-coded.
const heroPath = '/samples/skyscraper.jpg';
// The stage paints at 520 CSS px at most, so let the browser ask picturium for
// the size it will actually use rather than a fixed 900×600. Candidates are 3:2
// to match .stage-body — cropping in CSS would throw away the bytes the chip is
// bragging about saving.
const heroSizes = '(max-width: 980px) calc(100vw - 56px), 520px';
const heroParamsFor = (w: number) =>
  `w=${w}&h=${Math.round(w / 1.5)}&fit=cover&f=webp&q=82&watermark=${encodeURIComponent('image:picturium.png|opacity:70|anchor:top-right|scale:0.06')}`;
// cache= busts the browser/CDN copy per build (per request in dev), so the chip
// times a real fetch. Stripped again before the URL bar renders it.
const heroCacheBust = `cache=${Date.now()}`;
const heroSrcset = [520, 760, 1040, 1560]
  .map((w) => `${px(heroPath, `${heroParamsFor(w)}&${heroCacheBust}`)} ${w}w`)
  .join(', ');
// Picturium serves public/ as its source dir, so the original is right here —
// no need to ask the server how big it was.
const heroOriginalBytes = statSync(fileURLToPath(new URL(`../../public${heroPath}`, import.meta.url))).size;
const heroCredit = {
  by: 'Ü Lõ',
  href: 'https://unsplash.com/photos/skyscraper-with-illuminated-vertical-lines-C-672vHXRAg',
};

// Pixel field behind the hero: 28px squares in the logo rainbow, spilling out
// from behind the left edge of the image stage and thinning out to the left.
// Deterministic (seeded) so the build is reproducible. The shadows are dealt
// into a few divs so each group can twinkle on its own clock.
const hues = ['255, 58, 58', '255, 138, 31', '255, 214, 51', '51, 224, 102', '43, 212, 240', '58, 120, 255', '216, 60, 255'];
const seeded = (seed: number) => () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const pixelField = (() => {
  const cell = 28, cols = 26, rows = 27, groups = 5;
  const rand = seeded(0x9e3779b9);
  const shadows: string[][] = Array.from({ length: groups }, () => []);
  for (let c = 0; c < cols; c++) {
    // Density and alpha both fall off with distance from the stage.
    const near = 1 - c / cols;
    for (let r = 0; r < rows; r++) {
      if (rand() > near * 0.55) continue;
      const alpha = (0.10 + rand() * 0.30) * near;
      // group from position, not rand(), so the field itself stays the same
      shadows[(c * 7 + r * 3) % groups].push(`${-c * cell}px ${r * cell}px 0 rgba(${hues[(c + r) % hues.length]}, ${alpha.toFixed(3)})`);
    }
  }
  return shadows.map((g) => g.join(', '));
})();
// A few squares that hop out of the stage along the grid, one cell per step.
const pixelRunners = (() => {
  const rand = seeded(0x2545f491);
  return Array.from({ length: 8 }, (_, i) => {
    const n = 6 + Math.floor(rand() * 10);
    return `--r:${Math.floor(rand() * 24)};--n:${n};--h:${hues[i % hues.length]};--t:${(n * 0.32 + 3 + rand() * 4).toFixed(2)}s;--dl:${(-rand() * 9).toFixed(2)}s`;
  });
})();
// Mosaic over the hero image: cells clear in a diagonal sweep from the top
// left corner. Cells are square (12×8 on 3:2), so c + r is a true 45° front.
const stageCells = (() => {
  const rand = seeded(0x68e31da4);
  const cols = 12, rows = 8;
  return Array.from({ length: cols * rows }, (_, k) => {
    const c = k % cols, r = Math.floor(k / cols);
    return `--h:${hues[(c + r) % hues.length]};--d:${Math.round(((c + r) / (cols + rows - 2)) * 720 + rand() * 90)}`;
  });
})();

const features = [
  {
    title: 'Resize & crop',
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 13l5-5 4 4 4-4 5 5"/>',
    body: 'Set <code>w</code> and <code>h</code>, pick a fit mode, or let attention gravity find the subject before it crops.',
    href: '/docs/sizing',
  },
  {
    title: 'Rotate & orient',
    icon: '<path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 3v6h6"/>',
    body: 'Phone photos come out the right way up, thanks to EXIF. Turn anything else in 90° steps.',
    href: '/docs/sizing',
  },
  {
    title: 'Filters & effects',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4"/>',
    body: 'Blur, sharpen, pixelate, tone, sepia, duotone. Chain them with <code>|</code> in a single <code>filter</code> parameter.',
    href: '/docs/filters',
  },
  {
    title: 'Format conversion',
    icon: '<path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/><path d="M8 11l4 4 4-4"/><path d="M12 4v11"/>',
    body: '<code>f=auto</code> picks the best format each browser accepts: JPEG XL, AVIF, WebP, JPEG, PNG or GIF.',
    href: '/docs/output',
  },
  {
    title: 'Quality control',
    icon: '<path d="M3 6l9 4 9-4-9-4-9 4z"/><path d="M3 12l9 4 9-4"/><path d="M3 18l9 4 9-4"/>',
    body: '<code>q=high</code> adapts to image size and format. Cap output by pixels or bytes so nothing ships too heavy.',
    href: '/docs/output',
  },
  {
    title: 'Watermarks',
    icon: '<path d="M12 2.7l5.7 5.7a8 8 0 1 1-11.4 0z"/>',
    body: 'Stamp a logo or text in any corner, or tile it across the image. Set a default once, server-wide.',
    href: '/docs/watermarking',
  },
  {
    title: 'Memory & disk cache',
    icon: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96L12 12l8.73-5.04"/><path d="M12 22V12"/>',
    body: 'Results live in memory and on disk. Repeat requests never touch libvips.',
    href: '/docs/request-model',
  },
  {
    title: 'Files, not just images',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>',
    body: 'Render pages from PDFs, Office files and vector art, grab frames from video, and pass other files through untouched.',
    href: '/docs/documents',
  },
];

const faqs = [
  {
    q: 'What is picturium?',
    a: 'An HTTP server that transforms media on the fly. The path picks a file from your media folder, and the query string says what to do with it: resize, crop, filter, convert, compress. picturium renders it once with <code>libvips</code> and serves every later request from cache, so there is no thumbnail pipeline to build or maintain.',
    href: '/docs',
  },
  {
    q: 'How is it different from Cloudinary, imgproxy, or Thumbor?',
    a: 'It runs on your own hardware, so there is no per-image or per-transform pricing. It also reads far more than photos: HEIC, JXL, PSD, camera RAW, SVG, PDF, Office files and video frames all go through the same URL. And it comes with an official PHP library for signed URLs and responsive markup.',
    href: '/docs/php-library',
  },
  {
    q: 'Do I need to run my own server?',
    a: 'Yes, picturium is self-hosted. Run the one-line installer (or <code>docker run</code> the image yourself), point it at your media, and you\'re done. There is no hosted plan, and nothing phones home.',
    href: '/#install',
  },
  {
    q: 'What image and file formats can it read?',
    a: 'Almost anything visual. Photos: JPEG, PNG, TIFF, WebP, GIF, HEIF/HEIC/AVIF, JXL, JPEG 2000, BMP, ICO and camera RAW. Design files: PSD, SVG, EPS, AI, CorelDRAW and DXF. Plus PDF, Office documents and video. It writes JPEG, WebP, PNG, GIF, AVIF and JXL, and can also return PDF and SVG.',
    href: '/docs/reference#input',
  },
  {
    q: 'Is it really free?',
    a: 'Yes. picturium is MIT licensed and free for any use, commercial included. The source is on GitHub.',
    href: REPO,
  },
  {
    q: 'How do I stop people abusing the resize endpoint?',
    a: 'Turn on URL signing. With a secret set, every request needs an HMAC-SHA256 <code>token</code>, so picturium only serves URLs your application generated. Output limits (<code>output.max_width</code>, <code>max_height</code>, <code>max_size</code>) cap what a single response can cost. And when every worker and queue slot is busy, it answers <code>503 Too many requests</code> instead of falling over.',
    href: '/docs/request-model#signed-urls',
  },
  {
    q: 'How does caching work?',
    a: 'Rendered images are kept in memory and on disk. The cache key is the source file, the effective parameters and the output format, not the literal URL, so reordered parameters still hit the cache. Responses also carry <code>Cache-Control</code> (one week by default) and an <code>ETag</code>, so browsers and any CDN in front of picturium cache them too.',
    href: '/docs/request-model#caching--force',
  },
];

// Keep these verifiable: counts come from picturium2/src/process/source.rs,
// the SSIM figures from picturium2/bench/results.md.
// bench/results.md in the picturium repo: cold renders (caches off), 4 CPUs, 50 requests at concurrency 4, q=80.
// hit: repeat request served from cache, measured by hand (1–2 ms, larger outputs at the top end)
const bench = [
  { label: 'webp 1920×1080', hit: 2, pic: [567.9, 791.9], imp: [692.1, 895.3] },
  { label: 'webp 800×600 with alpha', hit: 1, pic: [130.0, 148.3], imp: [197.0, 247.7] },
  { label: 'webp 1600×1200 from 36 MPix', hit: 2, pic: [603.8, 780.8], imp: [712.6, 1297.6] },
  { label: 'webp from a GIF still', hit: 1, pic: [43.5, 57.1], imp: [71.3, 108.4] },
  { label: 'jpeg 1920×1080', hit: 2, pic: [217.5, 295.5], imp: [213.7, 342.0] },
];
const benchMax = Math.max(...bench.flatMap((r) => [r.pic[0], r.imp[0]]));
const ms = (v: number) => `${Math.round(v)} ms`;
---
<Base
  title="picturium — URL-driven image server written in Rust"
  description="The path chooses the source. The query string describes the result. picturium renders, caches, and serves the image you asked for."
>
  <main id="main">
    <!-- HERO -->
    <section class="hero">
      <div class="bg-layer bg-pixels" aria-hidden="true">
        <div class="px-field">
          {pixelField.map((g, i) => <i style={`box-shadow:${g};--g:${i}`}></i>)}
          {pixelRunners.map((st) => <b style={st}></b>)}
        </div>
      </div>

      <div class="hero-inner">
        <div class="hero-heading">
          <h1 class="hero-h1">
              Picture perfect, <span class="accent" >every time.</span>
          </h1>
        </div>

        <div class="hero-copy">
          <p class="hero-sub">
              picturium is a fast, self-hosted media server that resizes, converts
              and caches <em style="font-family: var(--f-display)">(not just)</em> your images on the fly,
              so every visitor gets exactly the file their screen needs.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="/docs">Get started</a>
            <a class="btn" href="#playground">
              Try it yourself
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M3 2l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
          <div class="hero-meta">
            <span>MIT licensed</span>
            <span class="dot"></span>
            <span>Written in Rust</span>
            <span class="dot"></span>
            <span>Docker-ready</span>
          </div>

          <p class="hero-run-hook">One command and you are ready to go:</p>
          <div class="hero-run">
            <code id="hero-run-cmd">curl -fsSL https://picturium.cc/install.sh | sh</code>
            <button type="button" class="hero-run-copy" data-copy="#hero-run-cmd" aria-label="Copy command">copy</button>
          </div>
        </div>

        <!-- right column: URL → image stage -->
        <aside class="hero-stage" aria-label="URL transformation example">
          <div class="stage-head">
            <span class="stage-method">GET</span>
            <div class="url-bar">
              <svg class="url-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
              <span class="host">{new URL(PICTURIUM).host}</span>
              <span class="path">{heroPath}</span><span class="params" id="hero-url-params">?{decodeURIComponent(heroParamsFor(1040))}</span>
            </div>
          </div>
          <div class="stage-body">
            <img
              class="stage-img"
              id="hero-img"
              src={px(heroPath, `${heroParamsFor(1040)}&${heroCacheBust}`)}
              srcset={heroSrcset}
              sizes={heroSizes}
              width="1040"
              height="693"
              alt=""
              data-original={heroOriginalBytes}
            />
            <div class="stage-reveal" aria-hidden="true">{stageCells.map((st) => <i style={st}></i>)}</div>
            <script is:inline>
              // Inline so the cells cover the image before its first paint, cached or not.
              // Plays on load, or on error so a failed fetch never stays hidden.
              (() => {
                if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
                const stage = document.currentScript.parentElement;
                const img = stage.querySelector('img');
                stage.classList.add('armed');
                // two frames so the covered state paints before the transition starts
                const done = () => requestAnimationFrame(() => requestAnimationFrame(() => stage.classList.add('is-in')));
                if (img.complete) return done();
                img.addEventListener('load', done, { once: true });
                img.addEventListener('error', done, { once: true });
              })();
            </script>
            <div class="stage-overlay">
              <div class="chip-group">
                <span class="stage-chip"><svg class="chip-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg><span id="hero-size">900 × 600 · webp</span></span>
                <span class="stage-chip" id="hero-ms"></span>
              </div>
              <span class="stage-chip stage-chip-delta" id="hero-delta"></span>
            </div>
          </div>
          <p class="stage-credit">
            Photo by <a href={heroCredit.href} target="_blank" rel="noopener noreferrer">{heroCredit.by}</a>
            on <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer">Unsplash</a>
          </p>
        </aside>
      </div>
    </section>

    <div class="ribbon"></div>

    <!-- LOGOS -->
    <section class="logos-band">
      <div class="logos-inner">
        <p>Quietly serving images at</p>
        <div class="logos-row">
          <a class="logo-mark" href="https://moderneobce.sk/" target="_blank" rel="noopener">
            <img src="/logos/moderneobce.svg" alt="Moderné Obce" />
          </a>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="how" id="how">
      <div class="section-head">
        <h2>The URL is the whole pipeline.</h2>
        <p>No resize jobs, no thumbnail folders, no upload step. Describe the image you want in the link, and picturium renders it on the first request and serves it from cache after that.</p>
      </div>

      <div class="how-flow">
        <div class="flow-step" style="--i:0">
          <span class="num">01</span>
          <h3>Drop files in a folder</h3>
          <p>Every file in it is already a URL. Photos, PDFs, SVGs and Office docs. No upload API.</p>
          <div class="code"><span class="k">media</span>/cat.jpg → <span class="v">/cat.jpg</span></div>
        </div>
        <div class="flow-arrow" style="--i:1" aria-hidden="true">
          <span class="flow-track"></span>
          {[0, 1, 2, 3].map((p) => <i style={`--p:${p}`}></i>)}
          <svg viewBox="0 0 80 20"><path d="M62 4 L72 10 L62 16" fill="none" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"/></svg>
        </div>
        <div class="flow-step" style="--i:2">
          <span class="num">02</span>
          <h3>Describe what you need</h3>
          <p>Size, crop, format, filters, watermark. Every option is a query parameter, so any <code>&lt;img&gt;</code> tag can use it.</p>
          <div class="code">/cat.jpg?<span class="k">w</span>=<span class="v">600</span>&amp;<span class="k">fit</span>=<span class="v">cover</span></div>
        </div>
        <div class="flow-arrow" style="--i:3" aria-hidden="true">
          <span class="flow-track"></span>
          {[0, 1, 2, 3].map((p) => <i style={`--p:${p}`}></i>)}
          <svg viewBox="0 0 80 20"><path d="M62 4 L72 10 L62 16" fill="none" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"/></svg>
        </div>
        <div class="flow-step" style="--i:4">
          <span class="num">03</span>
          <h3>Rendered once, served forever</h3>
          <p>libvips renders it on the first request. After that, it comes straight from cache.</p>
          <div class="code"><span class="k">1×</span> render → <span class="ok">∞×</span> cache</div>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="features">
      <div class="section-head">
        <h2>An image CDN, minus the bill.</h2>
        <p>Every feature below is a query parameter on your own server. No per-transform pricing, and nothing phones home.</p>
      </div>

      <div class="feature-grid">
        {features.map((f) => {
          const Tag = f.href ? 'a' : 'article';
          return (
            <Tag class="feature" href={f.href}>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={f.icon} />
              <h3>{f.title}</h3>
              <p set:html={f.body} />
            </Tag>
          );
        })}
      </div>
    </section>

    <!-- PLAYGROUND -->
    <section class="playground" id="playground">
      <div class="section-head">
        <h2>Try it yourself!</h2>
        <p>Drag a slider, pick a recipe or type straight into the URL. A real picturium server renders every change.</p>
      </div>
      <div class="playground-wrap"><Playground /></div>
    </section>

    <!-- INSTALL -->
    <section class="install" id="install">
      <div class="install-grid">
        <div class="install-copy">
          <h2 style="margin-top:14px">Ready before your coffee cools.</h2>
          <p>The installer asks a few questions, pulls the image, waits until it's healthy and prints your URL. Docker is all you need.</p>
          <ul class="install-list">
            <li>Press Enter through the defaults, or skip them all</li>
            <li>Turn on signed URLs and get the secret generated for you</li>
            <li>Run it again to upgrade. Config and secrets stay put</li>
            <li>Pinned to one version. No surprise updates</li>
          </ul>
        </div>

        <div class="term">
          <div class="term-tabs" role="tablist" aria-label="Install method">
            <button class="term-tab" id="tab-installer-tab" data-tab="installer" role="tab" aria-selected="true" aria-controls="tab-installer" tabindex="0">installer</button>
            <button class="term-tab" id="tab-docker-tab" data-tab="docker" role="tab" aria-selected="false" aria-controls="tab-docker" tabindex="-1">docker</button>
            <button class="term-tab" id="tab-config-tab" data-tab="config" role="tab" aria-selected="false" aria-controls="tab-config" tabindex="-1">config.toml</button>
          </div>
          <div class="term-body" id="tab-installer" role="tabpanel" aria-labelledby="tab-installer-tab" tabindex="0">
            <span class="com"># needs Docker with the compose plugin</span><br />
            <span class="prompt">$</span> curl -fsSL https://picturium.cc/install.sh | sh<br /><br />
            <span class="dim">Install directory [~/picturium]:</span><br />
            <span class="dim">Directory with the images to serve [~/picturium/data]:</span> <span class="str">/srv/media</span><br />
            <span class="dim">Port [20045]:</span><br />
            <span class="dim">Listen address (127.0.0.1 if behind a reverse proxy) [0.0.0.0]:</span><br />
            <span class="dim">Require signed URLs (recommended for public servers)? (y/n) [n]:</span> <span class="arg">y</span><br />
            <span class="dim">...</span><br /><br />
            <span class="ok">Picturium {VERSION} is running at http://127.0.0.1:20045</span><br /><br />
            <span class="com"># later: same command upgrades to the newest release</span><br />
            <span class="prompt">$</span> curl -fsSL https://picturium.cc/install.sh | sh<br />
            <span class="dim">Upgrade to {VERSION}? (y/n) [y]:</span>
          </div>
          <div class="term-body" id="tab-docker" role="tabpanel" aria-labelledby="tab-docker-tab" tabindex="0" hidden>
            <span class="com"># pull and run, mounting ./media as the source</span><br />
            <span class="prompt">$</span> docker run -d --name picturium \<br />
            &nbsp;&nbsp;&nbsp;&nbsp;-p <span class="arg">20045</span>:<span class="arg">20045</span> \<br />
            &nbsp;&nbsp;&nbsp;&nbsp;-v <span class="str">$(pwd)/media</span>:<span class="str">/app/data:ro</span> \<br />
            &nbsp;&nbsp;&nbsp;&nbsp;-v <span class="str">picturium-cache</span>:<span class="str">/app/cache</span> \<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="kw">lamka02sk/picturium</span>:<span class="arg">{VERSION}</span><br /><br />
            <span class="prompt">$</span> curl -I <span class="str">"http://localhost:20045/sample.jpg?w=600&amp;f=webp"</span><br />
            <span class="ok">HTTP/1.1 200 OK</span><br />
            <span class="dim">content-type: image/webp</span>
          </div>
          <div class="term-body" id="tab-config" role="tabpanel" aria-labelledby="tab-config-tab" tabindex="0" hidden>
            <span class="com"># config.toml — only include values you want to change</span><br />
            <span class="kw">[server]</span><br />
            host = <span class="str">"0.0.0.0"</span><br />
            port = <span class="arg">8080</span><br /><br />
            <span class="kw">[data]</span><br />
            dir = <span class="str">"./media"</span><br /><br />
            <span class="kw">[cache]</span><br />
            dir = <span class="str">"./cache"</span><br />
            <span class="kw">[cache.disk]</span><br />
            limit = <span class="arg">8192</span>  <span class="com"># MiB</span><br /><br />
            <span class="kw">[output]</span><br />
            quality = <span class="str">"high"</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PERFORMANCE -->
    <section class="perf">
      <div class="perf-inner">
        <div class="perf-copy">
          <h2 style="margin-top:14px">Fast on the first request. Instant on the second.</h2>
          <p>Every render runs on <code>libvips</code> and async Rust. Big sources are shrunk while they load, and identical requests arriving together are rendered once.</p>
          <p>After that, a memory and disk cache answers instead. It comes built in, and completely for free.</p>
          <div class="stack-row">
            <span class="tag"><b>axum</b> http</span>
            <span class="tag"><b>libvips</b> imaging</span>

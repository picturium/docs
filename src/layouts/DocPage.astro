---
import Base from './Base.astro';
import { VERSION } from '../consts';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  headings: MarkdownHeading[];
  crumbs?: { label: string; href: string }[];
  monoHeadings?: boolean;
}
const { title, description, headings, crumbs = [], monoHeadings = false } = Astro.props;

// the TOC is the h2 list — markdown generates the ids, so the two can't drift
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={`${title} · picturium docs`} description={description} ogType="article">
  <main id="main" class="refpage">
    <div class="bg-layer bg-grid"></div>

    <div class="ref-grid">
    <aside class="ref-side" id="ref-side">
      <button class="toc-toggle" id="toc-toggle" type="button" aria-expanded="false" aria-controls="toc-nav">
        <span class="toc-toggle-text">
          <span class="toc-toggle-kicker">On this page</span>
          <span class="toc-toggle-current" id="toc-current">{toc[0]?.text}</span>
        </span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 4.5l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <nav class="toc" id="toc-nav" aria-label="On this page">
        <p class="toc-label">On this page</p>
        {toc.map((h) => <a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>)}
      </nav>
    </aside>

    <div class:list={['ref-main', { 'mono-heads': monoHeadings }]}>
      <p class="crumb">
        <a href="/docs">Docs</a>
        {crumbs.map((c) => <Fragment> / <a href={c.href}>{c.label}</a></Fragment>)}
        {' / '}{title}
      </p>
      <header class="ref-head">
        <h1>{title} <span class="ver">v{VERSION}</span></h1>
      </header>
      <slot />
    </div>
    </div>
  </main>
</Base>

<script>
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]')].map(
      (a) => [a.dataset.toc as string, a] as const,
    ),
  );
  const sections = [...document.querySelectorAll<HTMLElement>('.ref-main h2[id]')];

  const side = document.getElementById('ref-side') as HTMLElement;
  const toggle = document.getElementById('toc-toggle') as HTMLButtonElement;
  const currentLabel = document.getElementById('toc-current') as HTMLElement;
  const navEl = document.querySelector('.nav') as HTMLElement;
  const crumb = document.querySelector('.crumb') as HTMLElement;

  // on mobile the nav, the TOC bar and the breadcrumb all stack up as sticky
  // chrome (offsetParent is null while the toggle is display:none on desktop)
  const isMobile = () => toggle.offsetParent !== null;
  const barTop = () => navEl.offsetHeight + (isMobile() ? side.offsetHeight : 0);
  const chromeHeight = () => barTop() + (isMobile() ? crumb.offsetHeight : 0);

  function setOffsets() {
    const s = document.documentElement.style;
    s.setProperty('--sticky-top', barTop() + 'px');
    s.setProperty('--toc-offset', chromeHeight() + 16 + 'px');
  }

  function sync() {
    const edge = chromeHeight() + 24;
    let current = sections[0]?.id;
    for (const s of sections) {
      if (s.getBoundingClientRect().top <= edge) current = s.id;
    }
    links.forEach((a, id) => a.classList.toggle('is-active', id === current));
    const active = current ? links.get(current) : undefined;
    if (active) currentLabel.textContent = active.textContent;

    // the bar only pays for its padding once it is actually pinned
    const stuck = side.getBoundingClientRect().top <= navEl.offsetHeight + 1;
    if (stuck !== side.classList.contains('is-stuck')) {
      side.classList.toggle('is-stuck', stuck);
      setOffsets();
    }
  }

  // mobile: the same list, collapsed behind a sticky bar showing where you are
  const setOpen = (open: boolean) => {
    side.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  };
  toggle.addEventListener('click', () =>
    setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  links.forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('click', (e) => {
    if (!side.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // MDX code fences all render as pre > code, so one shared control covers every page.
  document.querySelectorAll<HTMLPreElement>('.ref-main pre:has(> code)').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = 'Copy';
    button.setAttribute('aria-label', 'Copy code to clipboard');
    pre.append(button);
  });
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('.code-copy');
    if (!button) return;
    try {
      await navigator.clipboard.writeText(button.parentElement!.querySelector('code')!.innerText);
      button.textContent = 'Copied';
    } catch {
      button.textContent = 'Copy failed';
    }
    setTimeout(() => { button.textContent = 'Copy'; }, 1100);
  });

  setOffsets();
  sync();
  // IntersectionObserver drives the updates (fires without relying on scroll
  // events); the listeners are a cheap fallback for resize / manual scroll.
  const io = new IntersectionObserver(sync, {
    rootMargin: '-118px 0px -55% 0px',
    threshold: [0, 1],
  });
  sections.forEach((s) => io.observe(s));
  window.addEventListener('scroll', sync, { passive: true });
  window.addEventListener('resize', () => { setOffsets(); sync(); }, { passive: true });
</script>

<!-- global: the page body comes from MDX, which Astro's scoped styles don't reach -->
<style is:global>
  .refpage {
    position: relative;
    max-width: 1160px;
    margin: 0 auto;
    padding: 64px 28px 120px;
  }
  .refpage .bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    mask-image: linear-gradient(180deg, #000 0%, transparent 32%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 32%);
  }
  .refpage > * { position: relative; z-index: 1; }

  .ref-grid { display: grid; grid-template-columns: 1fr; }
  .ref-main { min-width: 0; }

  .ref-side { margin-bottom: 30px; }
  .toc-toggle { display: none; }
  .toc-label {
    margin: 0 0 10px;
    font-family: var(--f-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .ref-head { margin-bottom: 10px; }
  .crumb {
    margin: 0 0 14px;
    position: relative;
    z-index: 19;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--ink-3);
  }
  .crumb a { color: var(--ink-2); }
  .crumb a:hover { color: var(--accent); }

  .ref-head h1 {
    margin: 0 0 14px;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 38px;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink-0);
  }
  .ref-head .ver {
    margin-left: 8px;
    font-family: var(--f-mono);
    font-size: 14px;
    font-weight: 400;
    color: var(--ink-3);
    vertical-align: middle;
  }

  /* the lead is whatever paragraph the MDX opens with */
  .ref-main .ref-head + p {
    margin: 0 0 20px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 72ch;
  }

  /* mobile: horizontal pills above the content */
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .toc a {
    font-family: var(--f-mono);
    font-size: 11.5px;
    color: var(--ink-2);
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-1);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .toc a:hover { color: var(--accent); border-color: var(--line-2); }
  .toc a.is-active {
    color: var(--ink-0);
    border-color: var(--accent);
    background: var(--bg-2);
  }

  /* desktop: sticky sidebar list with scrollspy */
  @media (min-width: 920px) {
    .ref-grid {
      grid-template-columns: 208px minmax(0, 1fr);
      gap: 54px;
      align-items: start;
    }
    .ref-side {
      position: sticky;
      top: 84px;
      margin-bottom: 0;
      max-height: calc(100vh - 108px);
      overflow-y: auto;
    }
    .toc { display: flex; flex-direction: column; flex-wrap: nowrap; gap: 1px; }
    .toc a {
      border: 0;
      border-left: 2px solid var(--line);
      border-radius: 0;
      background: none;
      padding: 6px 12px;
      color: var(--ink-3);
    }
    .toc a:hover {
      color: var(--ink-1);
      border-left-color: var(--line-2);
      background: none;
    }
    .toc a.is-active {
      color: var(--ink-0);
      border-left-color: var(--accent);
      background: linear-gradient(90deg, var(--bg-2), transparent);
    }
  }

  .ref-main h2 {
    margin: 56px 0 18px;
    font-family: var(--f-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-0);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-soft);
    /* set from JS: clears the sticky nav, plus the TOC bar when it is shown */
    scroll-margin-top: var(--toc-offset, 80px);
  }
  /* config-key style pages head their sections with the TOML table name */
  .ref-main.mono-heads h2 {
    font-family: var(--f-mono);
    font-size: 15px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--accent);
  }
  .ref-main h3 {
    margin: 28px 0 8px;
    font-family: var(--f-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-1);
  }
  .ref-main h3 code { background: none; border: 0; padding: 0; color: var(--accent); }

  .ref-main ul, .ref-main p { max-width: 84ch; }
  .ref-main ul {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ref-main li, .ref-main p {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .ref-main p { margin: 0 0 12px; }
  .ref-main a { color: var(--ink-1); border-bottom: 1px solid var(--line-2); }
  .ref-main a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .crumb a { border-bottom: 0; }

  /* a run of monospaced values (format lists, config section names) */
  .ref-main p.fmt {
    margin: 0 0 14px;
    font-family: var(--f-mono);
    font-size: 12.5px;
    line-height: 1.9;
    color: var(--ink-2);
    max-width: 90ch;
    white-space: pre-wrap;
  }

  .ref-main code {
    font-family: var(--f-mono);
    font-size: 0.92em;
    color: var(--ink-1);
    background: var(--bg-2);
    border: 1px solid var(--line-soft);
    border-radius: 4px;
    padding: 1px 5px;
  }

  .ref-main pre {
    position: relative;
    margin: 0 0 14px;
    padding: 16px 18px;
    overflow-x: auto;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-lg);
    background: var(--bg-1) !important;
  }
  .ref-main pre code {
    display: block;
    background: none;
    border: 0;
    padding: 0 72px 0 0;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--ink-1);
  }
  .ref-main .code-copy {
    position: absolute;
    top: 14px;
    right: 9px;
    padding: 4px 9px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg-3);
    color: var(--ink-2);
    font: 10.5px var(--f-mono);
    text-transform: uppercase;
    cursor: pointer;
  }
  .ref-main .code-copy:hover,
  .ref-main .code-copy:focus-visible { color: var(--ink-0); border-color: var(--line-2); }

  /* ── mobile: TOC collapses into a sticky dropdown ── */
  @media (max-width: 919px) {
    .ref-side {
      position: sticky;
      top: var(--nav-h, 63px);
      z-index: 20;
      margin: 0 -18px 26px;
      padding: 0 18px 10px;
      background: var(--bg-0);
    }
    .ref-side.is-stuck {
      padding-top: 10px;
      border-bottom: 1px solid var(--line-soft);
    }
    .toc-label { display: none; }

    .toc-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      padding: 9px 14px;
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--bg-1);
      color: var(--ink-3);
      cursor: pointer;
      text-align: left;
      transition: border-color 0.15s, color 0.15s;
    }
    .toc-toggle:hover { border-color: var(--line-2); }
    .toc-toggle svg { flex-shrink: 0; transition: transform 0.18s; }
    .is-open .toc-toggle { border-color: var(--accent); }
    .is-open .toc-toggle svg { transform: rotate(180deg); }

    .toc-toggle-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .toc-toggle-kicker {
      font-family: var(--f-mono);
      font-size: 9.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .toc-toggle-current {
      font-size: 13.5px;
      font-weight: 500;
      color: var(--ink-0);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* the panel overlays the page instead of shoving it down */
    .toc {
      display: none;
      position: absolute;
      left: 18px;
      right: 18px;
      top: calc(100% - 4px);
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 2px;
      max-height: 60vh;
      overflow-y: auto;
      padding: 6px;
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--bg-1);
      box-shadow: var(--shadow-md);
    }
    .is-open .toc { display: flex; }
    .toc a {
      border: 0;
      border-radius: var(--r-sm);
      background: none;
      padding: 9px 10px;
      font-family: var(--f-body);
      font-size: 13.5px;
      color: var(--ink-2);
    }
    .toc a.is-active { color: var(--ink-0); background: var(--bg-3); border-color: transparent; }

    /* breadcrumb rides along right under the TOC bar */
    .crumb {
      position: sticky;
      top: var(--sticky-top, 141px);
      margin: -26px -18px 16px;
      padding: 8px 18px;
      background: var(--bg-0);
      border-bottom: 1px solid var(--line-soft);
    }
  }

  @media (max-width: 700px) {
    .refpage { padding: 40px 18px 72px; }
    .ref-head h1 { font-size: 28px; }
    .ref-main .ref-head + p { font-size: 14.5px; }
    .ref-main h2 { margin-top: 40px; }
    .ref-main p.fmt { font-size: 11.5px; overflow-x: auto; }

  }
</style>

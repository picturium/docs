---
import '../styles/global.css';
import GitHubIcon from '../components/GitHubIcon.astro';
import DocsSearch from '../components/DocsSearch.astro';
import { Font } from 'astro:assets';
import { VERSION, REPO, px } from '../consts';

const { title, description, ogType = 'website' } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
// Social preview: picturium serving its own OG card, sized to the 1.91:1 slot.
const ogImage = px('/picturium.png', 'w=1200&h=630&fit=contain&bg=0d1117&f=png');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'picturium',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  softwareVersion: VERSION,
  description,
  url: new URL('/', Astro.site).href,
  license: `${REPO}/blob/master/LICENSE`,
  codeRepository: REPO,
  programmingLanguage: 'Rust',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="picturium" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="picturium — URL-driven image server written in Rust" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  <!-- Preload only the two families in the first viewport; mono and pixel load
       on demand rather than competing with them for bandwidth. -->
  <Font cssVariable="--font-body" preload />
  <Font cssVariable="--font-display" preload />
  <Font cssVariable="--font-mono" />
  <Font cssVariable="--font-pixel" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- inline SVG defs for gradient strokes -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <linearGradient id="rainbowstroke" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#ff3a3a" />
        <stop offset="20%" stop-color="#ff8a1f" />
        <stop offset="40%" stop-color="#ffd633" />
        <stop offset="60%" stop-color="#33e066" />
        <stop offset="80%" stop-color="#2bd4f0" />
        <stop offset="100%" stop-color="#d83cff" />
      </linearGradient>
    </defs>
  </svg>

  <header class="nav">
    <div class="nav-left">
      <a href="/" class="nav-brand">
        <img src={px('/picturium.png', 'w=288&f=webp&q=90')} alt="picturium" width="144" height="20" />
      </a>
      <nav class="nav-links" aria-label="Main">
        <a href="/" class={path === '/' ? 'active' : undefined}>Home</a>
        <a href="/docs" class={path.startsWith('/docs') ? 'active' : undefined}>Docs</a>
        <a href="/docs/reference">Reference</a>
        <a href="/#playground">Playground</a>
        <a href="/#install">Install</a>
      </nav>
    </div>
    <div class="nav-right">
      <DocsSearch />
      <span class="nav-version">v{VERSION}</span>
      <a class="btn" href={REPO} target="_blank" rel="noopener">
        <GitHubIcon />
        GitHub
      </a>
      <a class="btn btn-primary" href="/docs">Get started</a>
    </div>
  </header>

  <slot />

  <script>
    // sticky offsets (mobile TOC, scroll-margin) need the real nav height
    const nav = document.querySelector('.nav');
    const setNavH = () =>
      document.documentElement.style.setProperty('--nav-h', nav.offsetHeight + 'px');
    setNavH();
    window.addEventListener('resize', setNavH, { passive: true });

    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  </script>

  <footer class="footer">
    <div class="footer-brand">
      <img src={px('/picturium.png', 'w=288&f=webp&q=90')} alt="picturium" width="144" height="20" />
      <p>A self-hosted image server written in Rust. Resize, convert and cache images straight from the URL. MIT licensed.</p>
    </div>
    <div>
      <h3>Project</h3>
      <ul>
        <li><a href="/docs">Documentation</a></li>
        <li><a href="/docs/reference">Quick reference</a></li>
        <li><a href="/#playground">Playground</a></li>
        <li><a href={`${REPO}/releases`} target="_blank" rel="noopener">Changelog</a></li>
        <li><a href={`${REPO}/blob/master/LICENSE`} target="_blank" rel="noopener">License</a></li>
      </ul>
    </div>
    <div>
      <h3>Community</h3>
      <ul>
        <li><a href={REPO} target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={`${REPO}/issues`} target="_blank" rel="noopener">Issues</a></li>
        <li><a href={`${REPO}/discussions`} target="_blank" rel="noopener">Discussions</a></li>
      </ul>
    </div>
    <div>
      <h3>Related</h3>
      <ul>
        <li><a href="https://www.libvips.org/" target="_blank" rel="noopener">libvips</a></li>
        <li><a href="https://github.com/tokio-rs/axum" target="_blank" rel="noopener">axum</a></li>
        <li><a href="https://www.rust-lang.org/" target="_blank" rel="noopener">rust-lang</a></li>
      </ul>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} picturium contributors · MIT</span>
      <span>v{VERSION} · written in Rust</span>
    </div>
  </footer>
</body>
</html>
